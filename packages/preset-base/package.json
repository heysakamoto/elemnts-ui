{
  "name": "@moto-ui/preset-base",
  "version": "0.0.0",
  "description": "PandaCSS presets for moto-ui with built-in colors and component styles.",
  "keywords": [
    "pandacss",
    "presets",
    "moto",
    "moto-ui",
    "design-system",
    "ui",
    "css",
    "panda"
  ],
  "author": {
    "name": "heysakamoto"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/heysakamoto/moto-ui.git",
    "directory": "packages/colors"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "package.json",
    "readme.md"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "lint": "biome lint .",
    "dev": "tsc && tsup --watch",
    "prepublishOnly": "pnpm run build",
    "build": "pnpm run clean && tsup && tsc"
  },
  "dependencies": {
    "@moto-ui/colors": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "@pandacss/dev": "^1.9.1",
    "@pandacss/preset-base": "^1.8.1"
  }
}
