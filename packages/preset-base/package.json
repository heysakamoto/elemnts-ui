{
	"name": "@moto-ui/preset-base",
	"version": "0.0.12",
	"description": "PandaCSS presets for moto-ui with built-in colors and component styles.",
	"keywords": [
		"pandacss",
		"presets",
		"moto",
		"moto-ui",
		"design-system",
		"ui",
		"css",
		"panda"
	],
	"author": {
		"name": "heysakamoto"
	},
	"repository": {
		"type": "git",
		"directory": "packages/preset-base",
		"url": "https://github.com/heysakamoto/moto-ui.git"
	},
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"package.json",
		"readme.md"
	],
	"main": "./dist/cjs/index.cjs",
	"module": "./dist/esm/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/esm/index.js",
			"require": "./dist/cjs/index.cjs"
		}
	},
	"scripts": {
		"clean": "rm -rf dist",
		"lint": "biome lint .",
		"dev": "tsc && tsup --watch",
		"prepublishOnly": "pnpm run build",
		"build": "pnpm run clean && tsup && tsc"
	},
	"dependencies": {
		"@moto-ui/core": "workspace:*"
	},
	"devDependencies": {
		"tsup": "^8.5.1"
	}
}
