{
	"name": "@moto-ui/colors",
	"version": "0.0.2",
	"sideEffects": false,
	"keywords": [
		"colors",
		"moto",
		"moto-ui",
		"tailwindcss",
		"design-system",
		"ui"
	],
	"description": "A comprehensive color library inspired by TailwindCSS v4, offering a wide range of colors and extended shades for modern web development.",
	"author": {
		"name": "heysakamoto"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/heysakamoto/moto-ui.git",
		"directory": "packages/colors"
	},
	"license": "MIT",
	"files": [
		"dist",
		"package.json",
		"readme.md"
	],
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"dependencies": {
		"@moto-ui/core": "workspace:*"
	},
	"devDependencies": {
		"tsdown": "^0.22.14"
	},
	"scripts": {
		"typecheck": "tsc",
		"lint": "biome lint .",
		"prepublishOnly": "pnpm run build",
		"build": "tsdown && pnpm run typecheck"
	}
}
