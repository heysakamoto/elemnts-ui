{
  "name": "@moto-ui/react",
  "version": "0.0.12",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.cjs",
  "types": "dist/types/index.d.ts",
  "module": "./dist/esm/index.js",
  "description": "An open source components library, providing 80+ components with a consistent design system.",
  "keywords": [
    "react",
    "component",
    "ui",
    "design-system",
    "moto",
    "moto-ui"
  ],
  "author": {
    "name": "heysakamoto"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/heysakamoto/moto-ui.git",
    "directory": "packages/react"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js",
      "require": "./dist/components/*/index.cjs"
    },
    "./styled/tokens": {
      "types": "./dist/styled/tokens/index.d.ts",
      "import": "./dist/styled/tokens/index.js",
      "require": "./dist/styled/tokens/index.js"
    },
    "./styled/types": {
      "types": "./dist/styled/types/index.d.ts",
      "import": "./dist/styled/types/index.js",
      "require": "./dist/styled/types/index.js"
    },
    "./styled/recipes": {
      "types": "./dist/styled/recipes/index.d.ts",
      "import": "./dist/styled/recipes/index.js",
      "require": "./dist/styled/recipes/index.js"
    },
    "./styled/jsx": {
      "types": "./dist/styled/jsx/index.d.ts",
      "import": "./dist/styled/jsx/index.js",
      "require": "./dist/styled/jsx/index.js"
    },
    "./buildinfo.json": "./dist/buildinfo.json"
  },
  "files": [
    "dist",
    "package.json",
    "readme.md"
  ],
  "scripts": {
    "panda:build": "panda",
    "dev": "tsdown --watch",
    "postbuild": "pnpm panda:ship",
    "prebuild": "pnpm panda:build",
    "build": "tsdown && pnpm typecheck",
    "storybook": "storybook dev -p 6007",
    "typecheck": "tsc -p tsconfig.build.json",
    "build:storybook": "storybook build -o dist-storybook",
    "panda:ship": "panda ship --outfile dist/buildinfo.json"
  },
  "devDependencies": {
    "@pandacss/dev": "^1.11.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tsdown": "^0.22.14"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@ark-ui/react": "^5.39.0",
    "@dnd-kit/react": "^0.4.0",
    "@iconify/react": "^6.0.2",
    "@moto-ui/core": "workspace:*",
    "@ncdai/react-wheel-picker": "^1.2.2"
  }
}