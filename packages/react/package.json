{
  "name": "@elemnts-ui/react",
  "version": "0.0.3",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.cjs",
  "types": "dist/types/index.d.ts",
  "module": "./dist/esm/index.js",
  "description": "An open source components library, providing 80+ components with a consistent design system.",
  "keywords": [
    "react",
    "component",
    "ui",
    "element",
    "accordion",
    "tab",
    "menu",
    "dropdown",
    "button",
    "badge",
    "tags-input",
    "editable",
    "avatar",
    "carousel",
    "collapsible",
    "color-picker",
    "date-picker",
    "dialog",
    "floating-panel",
    "pagination",
    "progress",
    "radio-group",
    "popover",
    "qr-code",
    "scroll-area",
    "select",
    "slider",
    "steps",
    "timer",
    "toast",
    "toggle",
    "tour",
    "listbox",
    "tooltip",
    "field",
    "marquee",
    "slider",
    "fieldset",
    "switch",
    "ark",
    "pandacss",
    "design-system",
    "elemnts",
    "elemnts-ui"
  ],
  "author": {
    "name": "heysakamoto"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/heysakamoto/elemnts-ui",
    "directory": "packages/react"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js",
      "require": "./dist/components/*/index.cjs"
    },
    "./hotkeys": {
      "types": "./dist/providers/hotkeys/index.d.ts",
      "import": "./dist/providers/hotkeys/index.js",
      "require": "./dist/providers/hotkeys/index.cjs"
    },
    "./buildinfo.json": "./dist/buildinfo.json"
  },
  "files": [
    "dist",
    "package.json",
    "readme.md"
  ],
  "scripts": {
    "build:js": "tsdown",
    "build:types": "tsc",
    "generate": "panda codegen",
    "dev": "storybook dev -p 6000",
    "build:info": "panda ship --outfile dist/buildinfo.json",
    "build": "pnpm build:js && pnpm build:types && pnpm build:info"
  },
  "devDependencies": {
    "@pandacss/dev": "^1.11.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tsdown": "^0.22.14"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@ark-ui/react": "^5.39.1",
    "@dnd-kit/react": "^0.4.0",
    "@elemnts-ui/core": "workspace:*",
    "@iconify/react": "^6.0.2",
    "@ncdai/react-wheel-picker": "^1.2.2"
  }
}