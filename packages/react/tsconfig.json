{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"outDir": "dist",
		"rootDir": "src",
		"declaration": true,
		"types": ["vite/client"],
		"emitDeclarationOnly": true
	},
	"include": ["src/**/*"],
	"exclude": [
		"src/extract.ts",
		"src/styled-system",
		"src/components/**/examples",
		"src/components/**/stories.tsx"
	]
}
