{
	"name": "@moto-ui/styled-system",
	"description": "A comprehensive CSS design system. Features Ark UI components recipes, OKLCH color scales, and a robust TypeScript-first developer experience.",
	"keywords": [
		"pandacss",
		"styled-system",
		"moto-ui",
		"tailwindcss",
		"design-system",
		"ui"
	],
	"files": [
		"dist",
		"package.json",
		"readme.md"
	],
	"author": {
		"name": "heysakamoto"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/heysakamoto/moto-ui.git",
		"directory": "packages/styled-system"
	},
	"publishConfig": {
		"access": "public"
	},
	"license": "MIT",
	"version": "0.0.7",
	"type": "module",
	"scripts": {
		"clean": "rm -rf dist",
		"dev": "panda --watch",
		"build": "panda"
	},
	"dependencies": {
		"@moto-ui/preset-base": "workspace:*"
	},
	"devDependencies": {
		"@pandacss/dev": "^1.11.3",
		"@types/react": "19.2.2",
		"react": "^19.2.7"
	},
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0"
	},
	"exports": {
		"./css": {
			"types": "./dist/css/index.d.ts",
			"require": "./dist/css/index.js",
			"import": "./dist/css/index.js"
		},
		"./tokens": {
			"types": "./dist/tokens/index.d.ts",
			"require": "./dist/tokens/index.js",
			"import": "./dist/tokens/index.js"
		},
		"./types": {
			"types": "./dist/types/index.d.ts",
			"require": "./dist/types/index.js",
			"import": "./dist/types/index.js"
		},
		"./recipes": {
			"types": "./dist/recipes/index.d.ts",
			"require": "./dist/recipes/index.js",
			"import": "./dist/recipes/index.js"
		},
		"./jsx": {
			"types": "./dist/jsx/index.d.ts",
			"require": "./dist/jsx/index.js",
			"import": "./dist/jsx/index.js"
		},
		"./styles.css": "./dist/styles.css"
	}
}
