# Ensures Storybook packages are hoisted to root node_modules
public-hoist-pattern[]=*storybook*
public-hoist-pattern[]=@storybook/*
public-hoist-pattern[]=@types/*

# Better peer dependency handling for monorepos
auto-install-peers=true
strict-peer-dependencies=false

# Faster installs
prefer-offline=true
side-effects-cache=true
